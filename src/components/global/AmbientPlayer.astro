---
/**
 * Sticky bottom-right ambient player.
 *
 * Generates the soundtrack at runtime using the Web Audio API — no asset,
 * no licensing, no bundle weight. Character: low cinematic drone (sub-bass
 * pulse + detuned filtered pad + occasional tension swell).
 *
 * Browser autoplay policy forbids audio without a user gesture. We mark the
 * toggle as "needs-tap" on load and attach capture-phase listeners for the
 * first interaction (pointer/key/touch/scroll/wheel). When that first
 * interaction fires, we create the AudioContext INSIDE the gesture handler
 * (the most reliable pattern, especially on iOS Safari) and start the drone.
 *
 * Audio is session-only — every fresh page load tries to start audio again.
 * Mute is per-session; refresh restores the default-on behavior.
 */
---

<button
  id="ambient-toggle"
  class="ambient-toggle"
  type="button"
  aria-label="Włącz / wyłącz dźwięk tła"
  title="Dźwięk tła (Matryca)"
  data-transition-persist="ambient"
>
  <span class="ambient-toggle__icon" id="ambient-icon" aria-hidden="true">♪</span>
  <span class="ambient-toggle__label" id="ambient-label">audio</span>
</button>

<style lang="scss">
  .ambient-toggle {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    border: 0.5px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: color 200ms, border-color 200ms, transform 200ms;
    text-transform: uppercase;

    &:hover {
      color: var(--accent);
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    &.is-on .ambient-toggle__icon {
      animation: ambient-pulse 2.6s ease-in-out infinite;
      color: var(--accent);
    }

    &.is-needs-tap {
      animation: ambient-glow 1.6s ease-in-out infinite;
      border-color: var(--accent);
      color: var(--accent);
    }
  }
  .ambient-toggle__icon { font-size: 13px; }

  @keyframes ambient-pulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.18); }
  }
  @keyframes ambient-glow {
    0%, 100% { box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08); }
    50%      { box-shadow: 0 0 0 8px rgba(163, 45, 45, 0.22); }
  }

  @media (max-width: 640px) {
    .ambient-toggle {
      right: 12px;
      bottom: 12px;
      padding: 6px 10px;
      font-size: 10px;
    }
  }
</style>

<script>
  // Ambient audio module. Single global instance, persists across Astro
  // view-transitions because the toggle is data-transition-persist.
  //
  // State machine (only one is active at a time):
  //   - 'idle'      : no AudioContext yet; waiting for first user gesture
  //   - 'on'        : context running, drone audible
  //   - 'off'       : user muted during session (or explainer paused us)
  //
  // The first user gesture (anywhere on the page) creates the context.
  // This works across all browsers including iOS Safari, which is strict
  // about requiring AudioContext creation inside a user gesture.
  (function () {
    if ((window as any).__matrycaAmbientReady) return;
    (window as any).__matrycaAmbientReady = true;

    let toggle: HTMLElement | null = null;
    let icon: HTMLElement | null = null;
    let label: HTMLElement | null = null;

    let ctx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let swellTimer: number | null = null;
    let state: 'idle' | 'on' | 'off' = 'idle';
    let intendedOn = true;   // session default — user can flip via toggle
    let suppressedByExplainer = false;

    function setVisual(s: 'on' | 'off' | 'needs-tap') {
      if (!toggle || !icon || !label) return;
      toggle.classList.toggle('is-on', s === 'on');
      toggle.classList.toggle('is-needs-tap', s === 'needs-tap');
      icon.textContent = s === 'on' ? '♫' : '♪';
      label.textContent = s === 'on' ? 'audio · on' : (s === 'needs-tap' ? 'tap audio' : 'audio · off');
    }

    function scheduleSwell() {
      if (!ctx || !masterGain || state !== 'on') return;
      const now = ctx.currentTime;
      const swellOsc = ctx.createOscillator();
      swellOsc.type = 'sawtooth';
      swellOsc.frequency.setValueAtTime(220, now);
      swellOsc.frequency.exponentialRampToValueAtTime(440, now + 5);
      const swellFilter = ctx.createBiquadFilter();
      swellFilter.type = 'bandpass';
      swellFilter.frequency.value = 1200;
      swellFilter.Q.value = 6;
      const swellGain = ctx.createGain();
      swellGain.gain.setValueAtTime(0, now);
      swellGain.gain.linearRampToValueAtTime(0.06, now + 2.5);
      swellGain.gain.linearRampToValueAtTime(0, now + 5);
      swellOsc.connect(swellFilter).connect(swellGain).connect(masterGain);
      swellOsc.start(now);
      swellOsc.stop(now + 5.5);
    }

    function startSwellTicker() {
      if (swellTimer) clearTimeout(swellTimer);
      const tick = () => {
        if (state !== 'on') return;
        scheduleSwell();
        swellTimer = window.setTimeout(tick, 18000 + Math.random() * 14000);
      };
      swellTimer = window.setTimeout(tick, 6000);
    }

    function stopSwellTicker() {
      if (swellTimer) { clearTimeout(swellTimer); swellTimer = null; }
    }

    function buildSoundscape(audioContext: AudioContext) {
      // Master gain — starts at 0, ramped up by caller after connect.
      const mg = audioContext.createGain();
      mg.gain.value = 0;
      mg.connect(audioContext.destination);

      // Sub-bass pulse
      const sub = audioContext.createOscillator();
      sub.type = 'sine';
      sub.frequency.value = 38;
      const subGain = audioContext.createGain();
      subGain.gain.value = 0.4;
      const subLfo = audioContext.createOscillator();
      subLfo.frequency.value = 0.18;
      const subLfoGain = audioContext.createGain();
      subLfoGain.gain.value = 0.25;
      subLfo.connect(subLfoGain).connect(subGain.gain);
      sub.connect(subGain).connect(mg);
      sub.start();
      subLfo.start();

      // Detuned pad (cinematic strings)
      const padFreqs = [110, 110.7, 220.4];
      const padFilter = audioContext.createBiquadFilter();
      padFilter.type = 'lowpass';
      padFilter.frequency.value = 800;
      padFilter.Q.value = 4;
      const padGain = audioContext.createGain();
      padGain.gain.value = 0.18;
      padFilter.connect(padGain).connect(mg);

      padFreqs.forEach((f) => {
        const osc = audioContext.createOscillator();
        osc.type = 'sawtooth';
        osc.frequency.value = f;
        const oscGain = audioContext.createGain();
        oscGain.gain.value = 0.5;
        osc.connect(oscGain).connect(padFilter);
        osc.start();
      });

      // Slow filter sweep
      const filterLfo = audioContext.createOscillator();
      filterLfo.frequency.value = 0.07;
      const filterLfoGain = audioContext.createGain();
      filterLfoGain.gain.value = 400;
      filterLfo.connect(filterLfoGain).connect(padFilter.frequency);
      filterLfo.start();

      return mg;
    }

    // Race ctx.resume() against a timeout — some browsers leave the promise
    // pending forever when autoplay is blocked. 500 ms is plenty for a real
    // user gesture to resolve it, and short enough to flip to needs-tap.
    async function resumeWithTimeout(audioContext: AudioContext): Promise<boolean> {
      if (audioContext.state === 'running') return true;
      try {
        await Promise.race([
          audioContext.resume(),
          new Promise<void>((_, reject) => setTimeout(() => reject(new Error('resume timeout')), 500)),
        ]);
      } catch {
        // Timeout or rejection — autoplay blocked
      }
      return audioContext.state === 'running';
    }

    /**
     * Try to start audio. Called from:
     *   - First user gesture handler (anywhere on the page)
     *   - Toggle button click
     *   - Explainer audio "off" message (restore after iframe music ends)
     *
     * Returns true if audio is now playing.
     */
    async function tryStart(): Promise<boolean> {
      if (state === 'on') return true;
      try {
        if (!ctx) {
          const Ctor = window.AudioContext || (window as any).webkitAudioContext;
          if (!Ctor) {
            setVisual('off');
            return false;
          }
          ctx = new Ctor();
          masterGain = buildSoundscape(ctx);
        }
        const ok = await resumeWithTimeout(ctx);
        if (!ok || !masterGain) {
          setVisual('needs-tap');
          return false;
        }
        // (Re)establish path to destination — stop() disconnects it.
        try { masterGain.connect(ctx.destination); } catch {}
        const t = ctx.currentTime;
        masterGain.gain.cancelScheduledValues(t);
        // Read current automation value (works even mid-ramp because we just
        // cancelled). Fallback to 0 if value getter is misleading.
        const cur = (masterGain.gain.value || 0);
        masterGain.gain.setValueAtTime(cur, t);
        masterGain.gain.linearRampToValueAtTime(0.22, t + 2.5);
        state = 'on';
        setVisual('on');
        startSwellTicker();
        return true;
      } catch {
        setVisual('needs-tap');
        return false;
      }
    }

    function stop() {
      state = 'off';
      stopSwellTicker();
      // Hard-cut: disconnect masterGain from destination. Synchronous, atomic.
      if (masterGain) { try { masterGain.disconnect(); } catch {} }
      if (ctx && ctx.state === 'running') { ctx.suspend().catch(() => {}); }
      setVisual('off');
    }

    // === First-interaction handler (autoplay fallback) ===
    // Fires on the first pointer/key/touch/scroll/wheel event anywhere on
    // the page, capture phase, so it beats page handlers (e.g. link clicks).
    // Once fired, the listeners self-remove.
    function installFirstInteractionHandler() {
      const onFirstInteract = (_e: Event) => {
        cleanup();
        if (intendedOn && state !== 'on') {
          // Fire-and-forget; tryStart() handles its own state updates
          tryStart();
        }
      };
      const opts: AddEventListenerOptions = { once: true, capture: true, passive: true };
      const evs = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'wheel', 'mousedown'];
      function cleanup() {
        for (const ev of evs) {
          document.removeEventListener(ev, onFirstInteract, true);
        }
      }
      for (const ev of evs) {
        document.addEventListener(ev, onFirstInteract, opts);
      }
    }

    // === Toggle button click ===
    function installToggleHandler(btn: HTMLElement) {
      btn.addEventListener('click', () => {
        if (state === 'on') {
          intendedOn = false;
          stop();
        } else {
          intendedOn = true;
          // Click is itself a user gesture — tryStart will create/resume ctx
          tryStart();
        }
      });
    }

    // === Explainer iframe messages ===
    window.addEventListener('message', (e: MessageEvent) => {
      if (!e.data || e.data.type !== 'matryca-explainer-audio') return;
      if (e.data.state === 'on') {
        // Explainer started — mute ambient if it's currently playing
        if (state === 'on') {
          suppressedByExplainer = true;
          stop();
          // Override visual so user knows it's paused, not off
          if (icon) icon.textContent = '♪';
          if (label) label.textContent = 'audio · paused';
          if (toggle) toggle.classList.remove('is-on');
        }
      } else if (e.data.state === 'off') {
        // Explainer ended — restore ambient if user had it on
        if (suppressedByExplainer && intendedOn) {
          suppressedByExplainer = false;
          tryStart();
        }
      }
    });

    // === Bootstrap (DOM-ready safe) ===
    function bootstrap() {
      toggle = document.getElementById('ambient-toggle');
      icon = document.getElementById('ambient-icon');
      label = document.getElementById('ambient-label');
      if (!toggle || !icon || !label) return;

      installToggleHandler(toggle);

      // Show optimistic "needs-tap" — most browsers will block autoplay anyway
      setVisual('needs-tap');

      // Try optimistic start. If browser allows (e.g. Media Engagement Index
      // grants it, or user has interacted with the site already in this
      // session), audio kicks in immediately. Otherwise needs-tap stays.
      tryStart().then((ok) => {
        if (!ok) installFirstInteractionHandler();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
    // Astro view-transitions: the toggle DOM is persisted, but the new page's
    // script tag would re-execute. The guard at the top prevents that —
    // bootstrap doesn't need to run again because closures are still alive.
  })();
</script>
